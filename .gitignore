# Data: never committed, regenerated by the pipeline
data/raw/*
data/interim/*
data/processed/*
data/embeddings/*
data/splits/*
!data/**/.gitkeep

# Reports: tables and figures are regenerated; logs are not committed
reports/logs/*
!reports/logs/.gitkeep

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
*.egg-info/
.venv/
.pytest_cache/

# Editors / OS
.vscode/
.idea/
Thumbs.db
desktop.ini
